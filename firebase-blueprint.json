{
  "collections": [
    {
      "name": "guestbook",
      "fields": [
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "role",
          "type": "string",
          "required": true
        },
        {
          "name": "message",
          "type": "string",
          "required": true
        },
        {
          "name": "timestamp",
          "type": "string",
          "required": true
        },
        {
          "name": "avatarColor",
          "type": "string",
          "required": true
        },
        {
          "name": "createdAt",
          "type": "timestamp",
          "required": true
        }
      ],
      "rules": [
        {
          "allow": "read",
          "condition": "true"
        },
        {
          "allow": "create",
          "condition": "request.resource.data.keys().hasAll(['name', 'role', 'message', 'timestamp', 'avatarColor', 'createdAt'])"
        }
      ]
    }
  ]
}
